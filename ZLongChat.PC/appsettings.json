{
  "ZLongChat": {
    // ---------------- 客户端配置 ----------------
    // 与后端 appsettings.json 使用**完全相同的节名**（ZLongChat:Client）。
    //
    // 这里只保留「只有本机才知道」的两项：
    //   ServerBaseUrl            —— 连哪台服务端
    //   UseServerProvidedConfig  —— 是否接受服务端下发的配置
    //
    // 其余全部由服务端通过 GET /api/client-config 下发：
    //   ICE 服务器（STUN/TURN）、ACK 超时、心跳间隔、重连间隔、P2P 参数……
    // 这样「改一处、所有客户端生效」，不必每台机器配一遍。
    //
    // 为什么客户端不需要留着 ICE 兜底？因为 P2P 建连要先靠服务端交换 SDP/ICE，
    // 服务端不可达时 P2P 本来也建不起来。拉取失败会退回代码缺省值（ZLongChatDefaults）
    // 并在日志里明确告警，不会静默降级。
    //
    // 需要在单机上临时覆盖某项时，写进 appsettings.Local.json（不要提交进仓库），
    // 路径与后端完全一致，例如：
    //   "ZLongChat": { "Client": { "ReconnectDelaySeconds": 10 } }
    "Client": {
      "ServerBaseUrl": "http://localhost:5000",
      "UseServerProvidedConfig": true
    }
  }
}
