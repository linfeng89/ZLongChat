<Window x:Class="ZLongChat.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZLongChat.PC"
        mc:Ignorable="d"
        Title="P2SP聊天客户端" Height="550" Width="500">
    <Grid Margin="10">
        <!-- 登录区域 -->
        <StackPanel x:Name="LoginPanel" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="我的用户ID：" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtMyUserId" Width="150" VerticalAlignment="Center" Text="user1"/>
                <Button x:Name="BtnLogin" Content="登录" Width="80" Margin="10,0,0,0" Click="BtnLogin_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="对方用户ID：" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTargetUserId" Width="150" VerticalAlignment="Center" Text="user2"/>
                <Button x:Name="BtnConnect" Content="发起连接" Width="80" Margin="10,0,0,0" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <!-- 消息列表 -->
        <ListBox x:Name="LstMessages" Height="350" Margin="0,60,0,70" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- 发送消息区域 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,0">
            <TextBox x:Name="TxtMessage" Height="30" Width="320" VerticalAlignment="Center"/>
            <Button x:Name="BtnSend" Content="发送" Width="80" Margin="10,0,0,0" Height="30" IsEnabled="False"/>
            <TextBlock x:Name="TxtStatus" Margin="20,0,0,0" VerticalAlignment="Center" Text="未连接" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
