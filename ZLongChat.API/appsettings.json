{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ZLongChat": {
    // ---------------- 服务端 ----------------
    // 监听地址。留空/删掉则交给 ASP.NET Core 决定（launchSettings / ASPNETCORE_URLS / 默认端口）
    "Server": {
      "Urls": [ "http://localhost:5000" ]
    },

    // 鉴权（当前是开发占位实现：只校验用户ID非空，签发固定前缀的假令牌）
    "Auth": {
      "DevTokenPrefix": "dev_token_"
    },

    // ---------------- 客户端配置 ----------------
    // 这一节既可作为本机客户端的运行参数，也会通过 GET /api/client-config 下发给所有客户端。
    // 所以「STUN/TURN 改这里一处，所有客户端一起生效」。
    "Client": {
      "ChatHubPath": "/chathub",

      "AckTimeoutMs": 3000,
      "HeartbeatIntervalMs": 5000,
      "HeartbeatTimeoutSeconds": 15,

      // 断线重连：按 2 倍退避 3s → 6s → 12s…，超过次数上限就停止自动重连并提示用户
      // （避免「没网 / 对端一直不在」时无限刷屏；期间消息仍走服务端转发）
      // MaxReconnectAttempts = 0 表示不限次数
      "ReconnectDelaySeconds": 3,
      "MaxReconnectAttempts": 3,
      "MaxReconnectDelaySeconds": 30,

      // P2P 建连超时（秒）。对端已下线时我方 Offer 拿不到 Answer，
      // ICE 永远不会失败 —— 靠这个超时才能判定「本次尝试失败」并继续重试。
      "P2PConnectTimeoutSeconds": 20,

      "DataChannelLabel": "chat",
      "GatherTimeoutMs": 30000,
      "SkipIPv6Candidates": true,

      // STUN 用于打洞，TURN 用于打洞失败时中继。
      // TURN 密码属于敏感信息，建议留空并改用环境变量注入：
      //   ZLongChat__Client__IceServers__2__Credential=真实密码
      "IceServers": [
        { "Url": "stun:stun.l.google.com:19302" },
        { "Url": "stun:127.0.0.1:3478" },
        {
          "Url": "turn:127.0.0.1:3478",
          "Username": "dev_user",
          "Credential": "dev_pass123"
        }
      ]
    }
  }
}
