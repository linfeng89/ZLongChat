<Project>

  <!--
    解决方案级公共构建属性。

    MSBuild 会在**每个项目文件的最前面**自动导入本文件，所以这里定义的属性
    所有项目都会继承 —— 「同一个设置」从此只需要在这里改一次。

    个别项目的差异（例如 PC 是 WPF，需要 net10.0-windows）在它自己的 csproj 里覆盖即可，
    项目文件里的值优先级高于本文件。
  -->
  <PropertyGroup>
    <!-- 目标框架：PC 覆盖为 net10.0-windows -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- 语言版本跟随 TFM 默认（net10.0 → C# 14）。不显式钉版本，避免升级 TFM 时忘记同步。 -->

    <!-- 可空引用类型 + 隐式 using：全解决方案统一强制开启 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 统一生成 XML 文档；CS1591 = 缺少 XML 注释，统一关掉避免噪音 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 产品信息与版本号，统一在此维护 -->
    <Product>ZLongChat</Product>
    <Company>ZLongChat</Company>
    <VersionPrefix>1.0.0</VersionPrefix>

    <!--
      可选：把告警当错误。当前全解决方案 0 告警，开启可防止回归。
      需要时把下面这行的注释去掉即可（建议等 CI 跑顺后再开）。
    -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
  </PropertyGroup>

</Project>
