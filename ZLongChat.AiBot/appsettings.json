{
  "ZLongChat": {
    // 与后端 / 客户端使用完全相同的节名（ZLongChat:Client）
    // 机器人只需要知道连哪台服务端；Hub 路径等用代码缺省值即可。
    "Client": {
      "ServerBaseUrl": "http://localhost:5000"
      // 机器人常驻服务端侧，不走 NAT 穿透，因此不需要 ICE 配置
    },

    // AI 机器人自身设置
    "AiBot": {
      "UserId": "aibot",

      // 每个会话保留的历史消息条数
      "HistoryLimit": 20,

      // 占位助手 EchoAiAssistant 的流式分片参数
      "ChunkSize": 6,
      "ChunkDelayMs": 60
    }
  }
}
